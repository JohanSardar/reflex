<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>si.eilmer.reflex.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>reflex</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_reflex-link._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Reflex uses the camera to scan the pairing code your Reflex Link shows, and to take photos you add to a Space.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Reflex finds and syncs with the Reflex Link on your computer over the local network.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Hold the mic button to talk to the Agents in a Space. Speech is transcribed on this iPad.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Reflex turns what you say into text on this iPad, so it can go with your Send.</string>
</dict>
</plist>
