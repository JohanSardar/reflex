{
  "name": "reflex",
  "private": true,
  "type": "module",
  "workspaces": [
    "protocol",
    "kernel/wasm",
    "agent",
    "link"
  ],
  "scripts": {
    "build:kernel-wasm": "sh kernel/wasm/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:protocol": "npm run check -w @reflex/protocol",
    "reflex-link": "node link/bin/reflex-link.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261024.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "wrangler": "4.152.0"
  }
}
