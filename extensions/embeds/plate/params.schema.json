{
  "type": "object",
  "properties": {
    "title": { "type": "string", "maxLength": 120 },
    "rows": { "type": "integer", "minimum": 1, "maximum": 32, "default": 8, "description": "Rows, lettered A, B, C, …" },
    "columns": { "type": "integer", "minimum": 1, "maximum": 48, "default": 12, "description": "Columns, numbered from 1." },
    "groups": {
      "type": "array", "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 40 },
          "color": { "type": "string", "maxLength": 7, "description": "red, orange, yellow, green, teal, blue, violet, pink, grey, or #rrggbb." }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "wells": { "type": "object", "description": "By well ID (A1, C12): {sample, group, label (5 characters shown in the well), color, flag (true draws a red slash)}. Marks return sample, group, label and flag." }
  },
  "additionalProperties": false
}
