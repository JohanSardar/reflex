{
  "type": "object",
  "properties": {
    "title": { "type": "string", "maxLength": 80 },
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 100, "description": "What a Mark on this row reports in target.rows." },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "kind": { "type": "string", "enum": ["body", "sketch", "pad", "pocket", "rib", "hole", "fillet", "chamfer", "pattern", "mirror", "shell", "other"], "description": "Sets the row's icon." },
          "part": { "type": "string", "maxLength": 256, "description": "The 3D model part this feature made, as read lists it." },
          "depth": { "type": "integer", "minimum": 0, "maximum": 8, "description": "Indent: 0 at the top level, 1 for a child, and so on." },
          "dims": { "type": "string", "maxLength": 120, "description": "Its key dimensions, shown under the name." },
          "status": { "type": "string", "enum": ["ok", "changed", "new", "suppressed", "error"], "description": "changed and new show a coloured tag, suppressed greys the row out, error shows it in red." },
          "note": { "type": "string", "maxLength": 200, "description": "A short note shown in the row, such as what changed." }
        },
        "required": ["id", "name"],
        "additionalProperties": false
      }
    }
  },
  "required": ["features"],
  "additionalProperties": false
}
