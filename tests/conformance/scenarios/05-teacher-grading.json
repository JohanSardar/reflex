{
  "scenario": 5,
  "title": "Teacher grading",
  "spec": "SPEC §16.5: a scanned paper with the AI's proposed marks as an overlay. The teacher taps to accept a mark, or strikes it out and writes their own.",
  "space": "grading",
  "setup": [ { "ops": [
    { "op": "add", "id": "paper", "type": "image", "src": "asset:7d3c2b1a0f9e8d7c6b5a4f3e2d1c0b9a8f7e6d5c4b3a2f1e0d9c8b7a6f5e4d3c", "alt": "Page 1 of the paper", "at": { "x": 0, "y": 0 }, "w": 600, "h": 800 },
    { "op": "add", "id": "prop-1", "type": "note", "text": "-1: units missing", "at": { "x": 640, "y": 200 }, "behaviors": [ { "on": "tap", "do": "notify", "payload": { "accept": "prop-1" } } ] },
    { "op": "add", "id": "prop-2", "type": "note", "text": "-2: wrong formula", "at": { "x": 640, "y": 400 } }
  ] } ],
  "sends": [
    {
      "draw": [],
      "raw": { "send": "s_grade1", "trigger": "behavior", "element": "a_claude:prop-1", "on": "tap" },
      "expect": { "frozen": { "kind": "tap", "trigger": "behavior" }, "marks": [] }
    },
    {
      "draw": [
        { "id": "ink-1", "points": [[630, 460], [740, 460], [850, 460]] },
        { "ids": ["ink-2", "ink-3", "ink-4"], "letters": [660, 560] }
      ],
      "raw": { "send": "s_grade2", "trigger": "button",
        "hints": [ { "strokes": ["ink-2", "ink-3", "ink-4"], "text": "-1 sign error", "confidence": 0.75 } ] },
      "expect": {
        "frozen": { "kind": "send" },
        "marks": [
          { "kind": "strike", "on": ["prop-2"] },
          { "kind": "writing", "text_guess": "-1 sign error" }
        ]
      }
    }
  ],
  "elements": ["paper", "prop-1", "prop-2"]
}
