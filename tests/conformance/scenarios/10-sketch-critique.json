{
  "scenario": 10,
  "title": "Sketch critique",
  "spec": "SPEC §16.10: corrections on a separate overlay the person can toggle; the original is never touched. The person circles what to fix, and the Mark says where on the sketch.",
  "space": "sketch-crit",
  "setup": [ { "ops": [
    { "op": "add", "id": "corrections", "type": "embed", "template": "overlay", "params": { "visible": true, "items": [ { "id": "c1", "kind": "line", "points": [[100, 100], [180, 160]], "text": "shoulder line" } ] }, "at": { "x": 0, "y": 0 }, "w": 600, "h": 800 },
    { "op": "add", "id": "critique", "type": "note", "color": "yellow", "w": 340, "text": "Strong gesture. The hands are small for the arms.", "at": { "x": 640, "y": 0 } }
  ] } ],
  "sends": [ {
    "draw": [
      { "id": "ink-1", "ellipse": [420, 520, 60, 50] },
      { "ids": ["ink-2", "ink-3", "ink-4"], "letters": [500, 600] }
    ],
    "raw": { "send": "s_sketch1", "trigger": "pencil",
      "hints": [ { "strokes": ["ink-2", "ink-3", "ink-4"], "text": "hand too small?", "confidence": 0.7 } ],
      "embed_anchors": [ { "element": "a_claude:corrections", "strokes": ["ink-1"], "anchor": { "kind": "local", "bounds": [360, 470, 120, 100], "label": "the sketch, away from the corrections" } } ] },
    "expect": {
      "marks": [
        { "kind": "circle", "on": ["corrections"], "target": { "kind": "local", "bounds": [360, 470, 120, 100] } },
        { "kind": "writing", "text_guess": "hand too small?" }
      ]
    }
  } ],
  "elements": ["corrections", "critique"]
}
