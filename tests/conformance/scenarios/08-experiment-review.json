{
  "scenario": 8,
  "title": "Morning experiment review",
  "spec": "SPEC §16.8: loss curves and queued runs. The person circles a suspicious cliff, then ticks one queued run and kills another.",
  "space": "morning-runs",
  "setup": [ { "ops": [
    { "op": "add", "id": "loss", "type": "embed", "template": "chart", "params": { "title": "train loss" }, "at": { "x": 0, "y": 0 }, "w": 500, "h": 300 },
    { "op": "add", "id": "run-1", "type": "shape", "shape": "rect", "text": "run 41: lr 3e-4", "at": { "x": 600, "y": 0 }, "w": 200, "h": 80 },
    { "op": "add", "id": "run-2", "type": "shape", "shape": "rect", "text": "run 42: lr 1e-3", "at": { "x": 600, "y": 140 }, "w": 200, "h": 80 }
  ] } ],
  "sends": [ {
    "draw": [
      { "id": "ink-1", "ellipse": [320, 150, 50, 40] },
      { "id": "ink-2", "points": [[660, 40], [680, 62], [740, 10]] },
      { "id": "ink-3", "points": [[650, 150], [700, 180], [750, 210]] },
      { "id": "ink-4", "points": [[750, 150], [700, 180], [650, 210]], "after_ms": 300 }
    ],
    "raw": { "send": "s_runs1", "trigger": "button",
      "embed_anchors": [ { "element": "a_claude:loss", "strokes": ["ink-1"], "anchor": { "kind": "data", "x": [1200, 1400], "label": "steps 1.2k–1.4k" } } ] },
    "expect": {
      "marks": [
        { "kind": "circle", "on": ["loss"], "target": { "kind": "data", "x": [1200, 1400] } },
        { "kind": "check", "on": ["run-1"] },
        { "kind": "cross", "on": ["run-2"] }
      ]
    }
  } ],
  "elements": ["loss", "run-1", "run-2"]
}
