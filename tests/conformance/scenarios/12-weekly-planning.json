{
  "scenario": 12,
  "title": "Weekly planning / journal",
  "spec": "SPEC §16.12: drag time blocks, journal by hand. The moves come back as changes, the journal as writing.",
  "space": "week",
  "setup": [ { "ops": [
    { "op": "add", "id": "mon", "type": "frame", "title": "Monday", "at": { "x": 0, "y": 0 }, "w": 220, "h": 400 },
    { "op": "add", "id": "tue", "type": "frame", "title": "Tuesday", "at": { "x": 240, "y": 0 }, "w": 220, "h": 400 },
    { "op": "add", "id": "block-gym", "type": "shape", "shape": "rect", "text": "Gym 7:00", "at": { "x": 10, "y": 40 }, "w": 200, "h": 60, "draggable": true },
    { "op": "add", "id": "block-deep", "type": "shape", "shape": "rect", "text": "Deep work 9:00", "at": { "x": 10, "y": 120 }, "w": 200, "h": 80, "draggable": true },
    { "op": "add", "id": "journal", "type": "region", "title": "Journal", "at": { "x": 0, "y": 440 }, "w": 460, "h": 200 }
  ] } ],
  "sends": [ {
    "draw": [
      { "move": ["block-gym"], "by": [240, 0] },
      { "ids": ["ink-1", "ink-2", "ink-3", "ink-4"], "letters": [20, 500] }
    ],
    "raw": { "send": "s_week1", "trigger": "button",
      "hints": [ { "strokes": ["ink-1", "ink-2", "ink-3", "ink-4"], "text": "slept badly, move gym", "confidence": 0.77 } ] },
    "expect": {
      "frozen": { "changes": [ { "kind": "moved", "by": [240, 0] } ] },
      "marks": [ { "kind": "writing", "text_guess": "slept badly, move gym" } ]
    }
  } ],
  "elements": ["mon", "tue", "block-gym", "block-deep", "journal"]
}
