{
  "scenario": 2,
  "title": "Math / physics tutor",
  "spec": "SPEC §16.2: a LaTeX problem with a writable Region and a \"Check my work\" button. Grading goes step by step, so the working comes back line by line.",
  "space": "algebra",
  "setup": [ { "ops": [
    { "op": "add", "id": "prompt", "type": "text", "text": "Solve for x. One step per line.", "at": { "x": 0, "y": 0 }, "w": 900 },
    { "op": "add", "id": "problem", "type": "math", "latex": "3x - 7 = 2x + 5", "at": { "x": 0, "y": 50 }, "w": 900 },
    { "op": "add", "id": "work", "type": "region", "title": "Your work", "send_button": "Check my work", "at": { "x": 0, "y": 140 }, "w": 900, "h": 600 }
  ] } ],
  "sends": [ {
    "draw": [
      { "ids": ["l1-1", "l1-2", "l1-3", "l1-4", "l1-5"], "letters": [40, 200] },
      { "ids": ["l2-1", "l2-2", "l2-3", "l2-4"], "letters": [40, 300] }
    ],
    "raw": { "send": "s_alg1", "trigger": "region", "region": "a_claude:work",
      "hints": [ { "strokes": ["l1-1", "l1-2", "l1-3", "l1-4", "l1-5"], "text": "3x - 2x = 5 + 7", "confidence": 0.9 },
                 { "strokes": ["l2-1", "l2-2", "l2-3", "l2-4"], "text": "x = 12", "confidence": 0.88 } ] },
    "expect": {
      "frozen": { "kind": "send", "trigger": "region" },
      "marks": [
        { "kind": "writing", "line": 1, "text_guess": "3x - 2x = 5 + 7" },
        { "kind": "writing", "line": 2, "text_guess": "x = 12" }
      ]
    }
  } ],
  "elements": ["prompt", "problem", "work"]
}
