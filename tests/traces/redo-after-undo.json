{
  "name": "Redo brings back the action most recently undone, not one abandoned by later work",
  "space": "redo",
  "replicas": ["ipad"],
  "steps": [
    { "on": "ipad", "person": "p_ana", "device": "ipad", "intent": { "intent": "add_stroke", "id": "A", "stroke": { "points": [[0, 0], [10, 10]] } }, "expect": { "ok": true } },
    { "on": "ipad", "person": "p_ana", "device": "ipad", "intent": { "intent": "undo" }, "expect": { "ok": true } },
    { "on": "ipad", "expect_absent": ["A"] },

    { "on": "ipad", "person": "p_ana", "device": "ipad", "intent": { "intent": "add_stroke", "id": "B", "stroke": { "points": [[20, 20], [30, 30]] } }, "expect": { "ok": true } },
    { "on": "ipad", "person": "p_ana", "device": "ipad", "intent": { "intent": "undo" }, "expect": { "ok": true } },
    { "on": "ipad", "expect_absent": ["A", "B"] },

    { "on": "ipad", "person": "p_ana", "device": "ipad", "intent": { "intent": "redo" }, "expect": { "ok": true } },
    { "on": "ipad", "expect_present": ["B"] },
    { "on": "ipad", "expect_absent": ["A"] }
  ]
}
