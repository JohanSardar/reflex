{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "read_me result",
  "type": "object",
  "properties": {
    "topic": {
      "type": "string",
      "maxLength": 63
    },
    "text": {
      "description": "The Guide, in Markdown.",
      "type": "string",
      "maxLength": 100000
    },
    "source": {
      "description": "Where it comes from: built in, an installed extension, or the person's Library (saved by an Agent with define).",
      "type": "string",
      "enum": [
        "builtin",
        "extension",
        "library"
      ]
    },
    "pending_sends": {
      "$ref": "#/$defs/pending_sends"
    }
  },
  "required": [
    "topic",
    "text",
    "source",
    "pending_sends"
  ],
  "additionalProperties": false,
  "$defs": {
    "count": {
      "description": "A non-negative integer in the shared safe range.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pending_sends": {
      "description": "How many Sends wait in this Agent's Inbox. Every tool result carries it. Drain them with wait_for_user(timeout_s: 0).",
      "$ref": "#/$defs/count"
    }
  }
}
