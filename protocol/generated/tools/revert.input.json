{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "revert input",
  "description": "Set batch or last, not both. Only your own batches can be reverted.",
  "type": "object",
  "properties": {
    "space": {
      "$ref": "#/$defs/space_name"
    },
    "batch": {
      "$ref": "#/$defs/batch_id"
    },
    "last": {
      "description": "Revert your last n batches in this Space.",
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "space"
  ],
  "minProperties": 2,
  "maxProperties": 2,
  "additionalProperties": false,
  "$defs": {
    "batch_id": {
      "type": "string",
      "pattern": "^b_[A-Za-z0-9]{1,40}$"
    },
    "space_name": {
      "description": "A Space's short, stable name, such as 'auth-plan'.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    }
  }
}
