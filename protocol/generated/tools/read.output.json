{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "read result",
  "description": "Exactly one of outline, elements or strokes is set, matching the requested detail.",
  "type": "object",
  "properties": {
    "space": {
      "$ref": "#/$defs/space_name"
    },
    "outline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scene_item"
      },
      "maxItems": 2000
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      },
      "maxItems": 500
    },
    "strokes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "The Ink Element's ID.",
            "$ref": "#/$defs/element_id"
          },
          "mark": {
            "description": "The Mark this stroke belongs to, if any.",
            "$ref": "#/$defs/mark_id"
          },
          "points": {
            "description": "[x, y, t, pressure] per sample: x and y in your coordinates (fractional), t in milliseconds since the stroke began, pressure from 0 to 1.",
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 86400000
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ],
              "items": false,
              "minItems": 4
            },
            "minItems": 1,
            "maxItems": 100000
          }
        },
        "required": [
          "id",
          "points"
        ],
        "additionalProperties": false
      },
      "maxItems": 2000
    },
    "elsewhere": {
      "description": "outline only: what matched nothing in this read.",
      "type": "object",
      "properties": {
        "on_screen": {
          "$ref": "#/$defs/count"
        },
        "off_screen": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "on_screen",
        "off_screen"
      ],
      "additionalProperties": false
    },
    "pending_sends": {
      "$ref": "#/$defs/pending_sends"
    }
  },
  "required": [
    "space",
    "pending_sends"
  ],
  "minProperties": 3,
  "additionalProperties": false,
  "$defs": {
    "agent_id": {
      "description": "An approved Agent's stable ID. It survives reconnects.",
      "type": "string",
      "pattern": "^a_[A-Za-z0-9]{1,40}$"
    },
    "agents_read_only": {
      "type": "boolean",
      "description": "When true, no Agent may write inside this Region. Default false."
    },
    "align": {
      "type": "string",
      "enum": [
        "start",
        "middle",
        "end"
      ]
    },
    "allow": {
      "description": "Extra network hosts this Embed may reach, on top of the person's allowlist.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9.-]{1,253}$"
      },
      "maxItems": 32
    },
    "alt": {
      "type": "string",
      "maxLength": 1000
    },
    "arrow": {
      "type": "string",
      "enum": [
        "end",
        "start",
        "both",
        "none"
      ]
    },
    "behavior": {
      "description": "What happens when someone interacts with an Element: one trigger (on) paired with one action (do). An Element can have several. Fields beyond on and do belong to the trigger or action named: event for embed_event; panel for open_panel; payload for notify and send; target and set for set; recipe and params for apply_recipe.",
      "type": "object",
      "properties": {
        "on": {
          "type": "string",
          "enum": [
            "tap",
            "long_press",
            "drag_end",
            "ink_inside",
            "panel_change",
            "embed_event"
          ]
        },
        "do": {
          "type": "string",
          "enum": [
            "open_panel",
            "notify",
            "send",
            "set",
            "apply_recipe"
          ]
        },
        "event": {
          "description": "embed_event only: the event name the Embed emits with reflex.emit(name, payload).",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,39}$"
        },
        "panel": {
          "$ref": "#/$defs/panel"
        },
        "payload": {
          "description": "notify and send: JSON passed to the Agent with the tap or Send.",
          "type": "object"
        },
        "target": {
          "description": "set only: the Element to change. Defaults to this Element.",
          "$ref": "#/$defs/element_id"
        },
        "set": {
          "description": "set only: fields to set on the target, as in patch.set.",
          "type": "object",
          "minProperties": 1
        },
        "recipe": {
          "description": "apply_recipe only: the Recipe's name.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "params": {
          "$ref": "#/$defs/params"
        }
      },
      "required": [
        "on",
        "do"
      ],
      "additionalProperties": false
    },
    "behaviors": {
      "description": "Trigger-action pairs, run when someone interacts with this Element.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/behavior"
      },
      "maxItems": 32
    },
    "bounds": {
      "description": "[x, y, width, height] in the reading Agent's coordinates. x and y are the top-left corner.",
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/coord"
        },
        {
          "$ref": "#/$defs/coord"
        },
        {
          "$ref": "#/$defs/length"
        },
        {
          "$ref": "#/$defs/length"
        }
      ],
      "items": false,
      "minItems": 4
    },
    "color": {
      "$ref": "#/$defs/common_color"
    },
    "common_color": {
      "description": "A named color. Reflex picks the exact shade for light and dark mode.",
      "type": "string",
      "enum": [
        "black",
        "grey",
        "white",
        "red",
        "orange",
        "yellow",
        "green",
        "teal",
        "blue",
        "violet",
        "pink"
      ]
    },
    "common_snap": {
      "description": "Snap rules for a draggable Element: to a grid, or to the given Elements.",
      "type": "object",
      "properties": {
        "grid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "to": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element_id"
          },
          "maxItems": 256
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "connector_text": {
      "type": "string",
      "maxLength": 400,
      "description": "A label drawn on the line."
    },
    "coord": {
      "description": "One coordinate in the reading Agent's own integer coordinate space for this Space. Its origin never moves (ADR-0007).",
      "type": "integer",
      "minimum": -1000000000,
      "maximum": 1000000000
    },
    "count": {
      "description": "A non-negative integer in the shared safe range.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "data": {
      "description": "A free JSON map the Agent defines, such as a task ID, a test case or a score. Reflex stores, syncs and returns it but never interprets it. At most 16 KiB of JSON per Element. Patch it with map_put and map_delete.",
      "type": "object",
      "maxProperties": 256
    },
    "display_name": {
      "description": "A human-readable name, such as 'Ana' or 'Claude Code · reflex repo'. It is data, never instructions.",
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "draggable": {
      "type": "boolean",
      "description": "Whether the person can drag it. Default false for Agent Elements."
    },
    "element": {
      "title": "Element",
      "description": "One Element as read(detail: 'full') returns it and as the scene JSON every renderer draws from. Built-in types have typed, top-level fields; extension types put theirs in props. type is the discriminator. Coordinates are the reading Agent's.",
      "oneOf": [
        {
          "title": "text",
          "description": "Plain text or Markdown.",
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/element_id"
            },
            "type": {
              "const": "text"
            },
            "owner": {
              "$ref": "#/$defs/principal"
            },
            "bounds": {
              "$ref": "#/$defs/bounds"
            },
            "text": {
              "$ref": "#/$defs/text"
            },
            "markdown": {
              "$ref": "#/$defs/markdown"
            },
            "size": {
              "$ref": "#/$defs/size"
            },
            "color": {
              "$ref": "#/$defs/color"
            },
            "align": {
              "$ref": "#/$defs/align"
            },
            "data": {
              "$ref": "#/$defs/element_data"
            },
            "behaviors": {
              "$ref": "#/$defs/behaviors"
            },
            "draggable": {
              "$ref": "#/$defs/draggable"
            },
            "locked": {
              "$ref": "#/$defs/locked"
            },
            "snap": {
              "$ref": "#/$defs/snap"
            }
          },
          "required": [
            "id",
            "type",
            "owner",
            "bounds",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "title": "note",
          "description": "A sticky note.",
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/element_id"
            },
            "type": {
              "const": "note"
            },
            "owner": {
              "$ref": "#/$defs/principal"
            },
            "bounds": {
              "$ref": "#/$defs/bounds"
            },
            "text": {
              "$ref": "#/$defs/note_text"
            },
            "color": {
              "$ref": "#/$defs/color"
            },
            "data": {
              "$ref": "#/$defs/element_data"
            },
            "behaviors": {
              "$ref": "#/$defs/behaviors"
            },
            "draggable": {
              "$ref": "#/$defs/draggable"
            },
            "locked": {
              "$ref": "#/$defs/locked"
            },
            "snap": {
              "$ref": "#/$defs/snap"
            }
          },
          "required": [
            "id",
            "type",
            "owner",
            "bounds",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "title": "math",
          "description": "LaTeX math, rendered natively.",
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/element_id"
            },
            "type": {
              "const": "math"
            },
            "owner": {
              "$ref": "#/$defs/principal"
            },
            "bounds": {
              "$ref": "#/$defs/bounds"
            },
            "latex": {
              "$ref": "#/$defs/latex"
            },
            "size": {
              "$ref": "#/$defs/size"
            },
            "color": {
              "$ref": "#/$defs/color"
            },
            "data": {
              "$ref": "#/$defs/element_data"
            },
            "behaviors": {
              "$ref": "#/$defs/behaviors"
            },
            "draggable": {
              "$ref": "#/$defs/draggable"
            },
            "locked": {
              "$ref": "#/$defs/locked"
            },
            "snap": {
              "$ref": "#/$defs/snap"
            }
          },
          "required": [
            "id",
            "type",
            "owner",
            "bounds",
            "latex"
          ],
          "additionalProperties": false
        },
        {
          "title": "shape",
          "description": "A shape with optional text inside it.",
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/element_id"
            },
            "type": {
              "const": "shape"
            },
            "owner": {
              "$ref": "#/$defs/principal"
            },
            "bounds": {
              "$ref": "#/$defs/bounds"
            },
            "shape": {
              "$ref": "#/$defs/shape"
            },
            "text": {
              "$ref": "#/$defs/shape_text"
            },
            "color": {
              "$ref": "#/$defs/color"
            },
            "fill": {
              "$ref": "#/$defs/fill"
            },
            "stroke": {
              "$ref": "#/$defs/stroke"
            },
            "data": {
              "$ref": "#/$defs/element_data"
            },
            "behaviors": {
              "$ref": "#/$defs/behaviors"
            },
            "draggable": {
              "$ref": "#/$defs/draggable"
            },
            "locked": {
              "$ref": "#/$defs/locked"
            },
            "snap": {
              "$ref": "#/$defs/snap"
            }
          },
          "required": [
            "id",
            "type",
            "owner",
            "bounds",
            "shape"
          ],
          "additionalProperties": false
        },
        {
          "title": "connector",
          "description": "A line or arrow. Bind both ends to Elements with from and to, and it follows them when they move. Or give points for a free line, such as an underline.",
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/element_id"
            },
            "type": {
              "const": "connector"
            },
            "owner": {
              "$ref": "#/$defs/principal"
            },
            "bounds": {
              "$ref": "#/$defs/bounds"
            },
            "from": {
              "$ref": "#/$defs/from"
            },
            "to": {
              "$ref": "#/$defs/to"
            },
            "points": {
              "$ref": "#/$defs/points"
            },
            "text": {
              "$ref": "#/$defs/connector_text"
            },
            "arrow": {
              "$ref": "#/$defs/arrow"
            },
            "stroke": {
              "$ref": "#/$defs/stroke"
            },
            "color": {
              "$ref": "#/$defs/color"
            },
            "data": {
              "$ref": "#/$defs/element_data"
            },
            "behaviors": {
              "$ref": "#/$defs/behaviors"
            },
            "draggable": {
              "$ref": "#/$defs/draggable"
            },
            "locked": {
              "$ref": "#/$defs/locked"
            },
            "snap": {
              "$ref": "#/$defs/snap"
            }
          },
          "required": [
            "id",
            "type",
            "owner",
            "bounds"
          ],
          "additionalProperties": false
        },
        {
          "title": "image",
          "description": "A picture. Photos and PDF pages the person adds become images they can write on.",
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/element_id"
            },
            "type": {
              "const": "image"
            },
            "owner": {
              "$ref": "#/$defs/principal"
            },
            "bounds": {
              "$ref": "#/$defs/bounds"
            },
            "src": {
              "$ref": "#/$defs/src"
            },
            "alt": {
              "$ref": "#/$defs/alt"
            },
            "page": {
              "$ref": "#/$defs/page"
            },
            "data": {
              "$ref": "#/$defs/element_data"
            },
            "behaviors": {
              "$ref": "#/$defs/behaviors"
            },
            "draggable": {
              "$ref": "#/$defs/draggable"
            },
            "locked": {
              "$ref": "#/$defs/locked"
            },
            "snap": {
              "$ref": "#/$defs/snap"
            }
          },
          "required": [
            "id",
            "type",
            "owner",
            "bounds",
            "src"
          ],
          "additionalProperties": false
        },
        {
          "title": "frame",
          "description": "A titled container. Elements placed inside it move with it.",
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/element_id"
            },
            "type": {
              "const": "frame"
            },
            "owner": {
              "$ref": "#/$defs/principal"
            },
            "bounds": {
              "$ref": "#/$defs/bounds"
            },
            "title": {
              "$ref": "#/$defs/title"
            },
            "color": {
              "$ref": "#/$defs/color"
            },
            "data": {
              "$ref": "#/$defs/element_data"
            },
            "behaviors": {
              "$ref": "#/$defs/behaviors"
            },
            "draggable": {
              "$ref": "#/$defs/draggable"
            },
            "locked": {
              "$ref": "#/$defs/locked"
            },
            "snap": {
              "$ref": "#/$defs/snap"
            }
          },
          "required": [
            "id",
            "type",
            "owner",
            "bounds"
          ],
          "additionalProperties": false
        },
        {
          "title": "region",
          "description": "An area with its own rules: whether Ink is allowed, whether Agents may write there, watch mode, and a Send button scoped to it.",
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/element_id"
            },
            "type": {
              "const": "region"
            },
            "owner": {
              "$ref": "#/$defs/principal"
            },
            "bounds": {
              "$ref": "#/$defs/bounds"
            },
            "title": {
              "$ref": "#/$defs/title"
            },
            "ink": {
              "$ref": "#/$defs/ink"
            },
            "agents_read_only": {
              "$ref": "#/$defs/agents_read_only"
            },
            "watch": {
              "$ref": "#/$defs/watch"
            },
            "send_button": {
              "$ref": "#/$defs/send_button"
            },
            "data": {
              "$ref": "#/$defs/element_data"
            },
            "behaviors": {
              "$ref": "#/$defs/behaviors"
            },
            "draggable": {
              "$ref": "#/$defs/draggable"
            },
            "locked": {
              "$ref": "#/$defs/locked"
            },
            "snap": {
              "$ref": "#/$defs/snap"
            }
          },
          "required": [
            "id",
            "type",
            "owner",
            "bounds"
          ],
          "additionalProperties": false
        },
        {
          "title": "embed",
          "description": "Web or 3D content Reflex does not natively understand, sandboxed. Use one of: template (an Embed Template, with params), html (inline HTML), url (an MCP App 'ui://' resource or an https page), or model (a USDZ or glTF asset).",
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/element_id"
            },
            "type": {
              "const": "embed"
            },
            "owner": {
              "$ref": "#/$defs/principal"
            },
            "bounds": {
              "$ref": "#/$defs/bounds"
            },
            "template": {
              "$ref": "#/$defs/template"
            },
            "params": {
              "$ref": "#/$defs/element_params"
            },
            "html": {
              "$ref": "#/$defs/html"
            },
            "url": {
              "$ref": "#/$defs/url"
            },
            "model": {
              "$ref": "#/$defs/model"
            },
            "allow": {
              "$ref": "#/$defs/allow"
            },
            "state": {
              "$ref": "#/$defs/state"
            },
            "data": {
              "$ref": "#/$defs/element_data"
            },
            "behaviors": {
              "$ref": "#/$defs/behaviors"
            },
            "draggable": {
              "$ref": "#/$defs/draggable"
            },
            "locked": {
              "$ref": "#/$defs/locked"
            },
            "snap": {
              "$ref": "#/$defs/snap"
            }
          },
          "required": [
            "id",
            "type",
            "owner",
            "bounds"
          ],
          "additionalProperties": false
        },
        {
          "title": "ink",
          "description": "One finished stroke of a person's Ink. Agents can never change or remove it. Read its points with read(detail: 'strokes').",
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/element_id"
            },
            "type": {
              "const": "ink"
            },
            "owner": {
              "$ref": "#/$defs/principal"
            },
            "bounds": {
              "$ref": "#/$defs/bounds"
