{
  "space": "auth-plan",
  "in_reply_to": "s_12",
  "look": true,
  "request": "req-2026-11-10-0007",
  "ops": [
    { "op": "add", "id": "n-auth", "type": "shape", "shape": "rect", "text": "Auth service",
      "at": { "right_of": "n-gateway", "gap": 80 },
      "data": { "ticket": "AUTH-142", "owner_team": "identity" },
      "behaviors": [
        { "on": "tap", "do": "open_panel",
          "panel": { "title": "Auth service", "components": [
            { "kind": "markdown", "text": "Issues JWTs for the gateway. **Owner:** identity team." },
            { "kind": "choice", "id": "priority", "label": "Priority", "options": ["low", "medium", "high"], "value": "medium" },
            { "kind": "button", "label": "Send my choice", "do": "send" }
          ] } }
      ] },
    { "op": "add", "id": "e1", "type": "connector", "from": "n-gateway", "to": "n-auth", "text": "JWT" },
    { "op": "add", "type": "note", "text": "Agreed, merging these.", "color": "yellow", "at": { "near": "m1" } },
    { "op": "add", "id": "eq-1", "type": "math", "latex": "p_{99} \\le 120\\,\\text{ms}", "at": { "below": "n-auth", "gap": 24 } },
    { "op": "add", "id": "sim-1", "type": "embed", "template": "chart", "params": { "metric": "latency_p99" },
      "w": 480, "h": 320, "at": { "x": 1000, "y": 200 },
      "behaviors": [ { "on": "embed_event", "event": "outlier_picked", "do": "notify", "payload": { "source": "latency chart" } } ] },
    { "op": "add", "id": "ok-1", "type": "shape", "shape": "ellipse", "text": "Ready", "color": "green", "fill": "tint",
      "draggable": true, "snap": { "to": ["col-todo", "col-done"] },
      "behaviors": [ { "on": "drag_end", "do": "set", "set": { "color": "blue" } } ] },
    { "op": "patch", "id": "n-db", "set": { "text": "Postgres", "color": "red" },
      "map_put": [ { "field": "data", "key": "version", "value": 16 } ] },
    { "op": "patch", "id": "n-auth", "text_insert": [ { "field": "text", "at": 4, "text": "entication" } ] },
    { "op": "remove", "ids": ["n-cache"] },
    { "op": "arrange", "ids": ["n-gateway", "n-auth", "n-users"], "layout": "row", "gap": 40 },
    { "op": "focus", "ids": ["n-auth"] },
    { "op": "define", "kind": "recipe", "name": "service-card",
      "summary": "A service box with its owning team and a tap-to-open detail Panel.",
      "params": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "team": { "type": "string" } }, "required": ["id", "name", "team"], "additionalProperties": false },
      "template": [
        { "op": "add", "type": "shape", "id": "{{id}}", "shape": "rounded", "text": "{{name}}", "data": { "team": "{{team}}" },
          "behaviors": [ { "on": "tap", "do": "open_panel", "panel": { "title": "{{name}}", "components": [ { "kind": "text", "text": "Owned by {{team}}." } ] } } ] }
      ] }
  ]
}
