{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reflex.eilmer.si/protocol/v1/request_attention.input.schema.json",
  "title": "request_attention input",
  "type": "object",
  "properties": {
    "space": { "$ref": "common.schema.json#/$defs/space_name" },
    "message": { "description": "The banner text, one short line.", "type": "string", "minLength": 1, "maxLength": 120 },
    "ids": { "description": "Elements to show when the person taps the banner.", "type": "array", "items": { "$ref": "common.schema.json#/$defs/element_id" }, "minItems": 1, "maxItems": 100 }
  },
  "required": ["space", "message"],
  "additionalProperties": false
}
