{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reflex.eilmer.si/protocol/v0/recipe.input.schema.json",
  "title": "recipe input",
  "type": "object",
  "properties": {
    "space": { "$ref": "common.schema.json#/$defs/space_name" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "params": { "$ref": "common.schema.json#/$defs/params" },
    "at": { "description": "Where the Recipe's group goes.", "$ref": "common.schema.json#/$defs/placement" },
    "in_reply_to": { "$ref": "common.schema.json#/$defs/send_id" },
    "look": { "type": "boolean" },
    "request": { "$ref": "common.schema.json#/$defs/request_id" }
  },
  "required": ["space", "name"],
  "additionalProperties": false
}
