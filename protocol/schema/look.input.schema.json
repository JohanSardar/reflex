{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reflex.eilmer.si/protocol/v0/look.input.schema.json",
  "title": "look input",
  "description": "Set ids or bounds, not both. With neither, look renders your current focus, or the whole Space.",
  "type": "object",
  "properties": {
    "space": { "$ref": "common.schema.json#/$defs/space_name" },
    "ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/target_ref" }, "minItems": 1, "maxItems": 500 },
    "bounds": { "$ref": "common.schema.json#/$defs/bounds" },
    "width": { "description": "Image width in pixels. Default 1024.", "type": "integer", "minimum": 128, "maximum": 2048 }
  },
  "required": ["space"],
  "additionalProperties": false
}
