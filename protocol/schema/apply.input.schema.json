              }
            },
            "required": [
              "op",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "title": "add extension",
            "description": "Add an Element of an extension type. Its fields go in props. If props fail the type's schema, the error includes a schema excerpt and one example. Call read_me(type) first.",
            "type": "object",
            "properties": {
              "op": {
                "const": "add"
              },
              "type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,39}$",
                "not": {
                  "enum": [
                    "text",
                    "note",
                    "math",
                    "shape",
                    "connector",
                    "image",
                    "frame",
                    "region",
                    "embed",
                    "ink",
                    "file"
                  ]
                }
              },
              "id": {
                "$ref": "element.schema.json#/$defs/new_id"
              },
              "at": {
                "$ref": "element.schema.json#/$defs/at"
              },
              "w": {
                "$ref": "element.schema.json#/$defs/w"
              },
              "h": {
                "$ref": "element.schema.json#/$defs/h"
              },
              "props": {
                "type": "object"
              },
              "data": {
                "$ref": "element.schema.json#/$defs/data"
              },
              "behaviors": {
                "$ref": "element.schema.json#/$defs/behaviors"
              },
              "draggable": {
                "$ref": "element.schema.json#/$defs/draggable"
              },
              "locked": {
                "$ref": "element.schema.json#/$defs/locked"
              },
              "snap": {
                "$ref": "element.schema.json#/$defs/snap"
              }
            },
            "required": [
              "op",
              "type",
              "props"
            ],
            "additionalProperties": false
          },
          {
            "title": "patch",
            "description": "Change one of your Elements with explicit field operations. Each key is one operation; use as many as you need. Their merge behavior with concurrent edits is defined, so prefer text_insert over setting the whole text.",
            "type": "object",
            "properties": {
              "op": {
                "const": "patch"
              },
              "id": {
                "$ref": "common.schema.json#/$defs/element_id"
              },
              "set": {
                "description": "Fields to set to new values.",
                "type": "object",
                "properties": {
                  "text": {
                    "$ref": "element.schema.json#/$defs/text"
                  },
                  "markdown": {
                    "$ref": "element.schema.json#/$defs/markdown"
                  },
                  "size": {
                    "$ref": "element.schema.json#/$defs/size"
                  },
                  "color": {
                    "$ref": "element.schema.json#/$defs/color"
                  },
                  "align": {
                    "$ref": "element.schema.json#/$defs/align"
                  },
                  "latex": {
