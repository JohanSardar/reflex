                  },
                  "from": {
                    "$ref": "element.schema.json#/$defs/from"
                  },
                  "to": {
                    "$ref": "element.schema.json#/$defs/to"
                  },
                  "points": {
                    "$ref": "element.schema.json#/$defs/points"
                  },
                  "arrow": {
                    "$ref": "element.schema.json#/$defs/arrow"
                  },
                  "src": {
                    "$ref": "element.schema.json#/$defs/src"
                  },
                  "alt": {
                    "$ref": "element.schema.json#/$defs/alt"
                  },
                  "page": {
                    "$ref": "element.schema.json#/$defs/page"
                  },
                  "title": {
                    "$ref": "element.schema.json#/$defs/title"
                  },
                  "ink": {
                    "$ref": "element.schema.json#/$defs/ink"
                  },
                  "agents_read_only": {
                    "$ref": "element.schema.json#/$defs/agents_read_only"
                  },
                  "watch": {
                    "$ref": "element.schema.json#/$defs/watch"
                  },
                  "send_button": {
                    "$ref": "element.schema.json#/$defs/send_button"
                  },
                  "template": {
                    "$ref": "element.schema.json#/$defs/template"
                  },
                  "params": {
                    "$ref": "element.schema.json#/$defs/params"
                  },
                  "html": {
                    "$ref": "element.schema.json#/$defs/html"
                  },
                  "url": {
                    "$ref": "element.schema.json#/$defs/url"
                  },
                  "model": {
                    "$ref": "element.schema.json#/$defs/model"
                  },
                  "allow": {
                    "$ref": "element.schema.json#/$defs/allow"
                  },
                  "at": {
                    "$ref": "element.schema.json#/$defs/at"
                  },
                  "w": {
                    "$ref": "element.schema.json#/$defs/w"
                  },
                  "h": {
                    "$ref": "element.schema.json#/$defs/h"
                  },
                  "props": {
                    "$ref": "element.schema.json#/$defs/set_props"
                  },
                  "data": {
                    "$ref": "element.schema.json#/$defs/set_data"
                  },
                  "behaviors": {
                    "$ref": "element.schema.json#/$defs/behaviors"
                  },
                  "draggable": {
                    "$ref": "element.schema.json#/$defs/draggable"
                  },
                  "locked": {
                    "$ref": "element.schema.json#/$defs/locked"
                  },
                  "snap": {
                    "$ref": "element.schema.json#/$defs/snap"
                  }
                },
                "minProperties": 1,
                "additionalProperties": false
              },
              "unset": {
                "description": "Fields to clear back to their defaults.",
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "text",
                    "markdown",
                    "size",
                    "color",
                    "align",
                    "latex",
                    "fill",
                    "stroke",
                    "from",
                    "to",
                    "points",
                    "arrow",
                    "alt",
                    "page",
                    "title",
                    "ink",
                    "agents_read_only",
                    "watch",
                    "send_button",
                    "params",
                    "allow",
                    "w",
                    "h",
                    "props",
                    "data",
                    "behaviors",
                    "draggable",
                    "locked",
                    "snap"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "text_insert": {
                "description": "Insert text at a UTF-16 offset.",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "enum": [
                        "text",
                        "latex",
                        "alt",
                        "title",
                        "html"
                      ]
                    },
                    "at": {
                      "$ref": "common.schema.json#/$defs/count"
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 20000
                    }
                  },
                  "required": [
                    "field",
                    "at",
                    "text"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 64
              },
              "text_delete": {
                "description": "Delete len UTF-16 code units starting at at.",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "enum": [
                        "text",
                        "latex",
                        "alt",
                        "title",
                        "html"
                      ]
                    },
                    "at": {
                      "$ref": "common.schema.json#/$defs/count"
                    },
                    "len": {
                      "$ref": "common.schema.json#/$defs/count"
                    }
                  },
                  "required": [
                    "field",
                    "at",
                    "len"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 64
              },
              "list_insert": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "enum": [
                        "behaviors",
                        "points",
                        "allow"
                      ]
                    },
                    "index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000
                    },
                    "value": {}
                  },
                  "required": [
                    "field",
                    "index",
                    "value"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 64
              },
              "list_move": {
