{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reflex.eilmer.si/protocol/v0/revert.output.schema.json",
  "title": "revert result",
  "description": "A revert is itself a new batch. Changes a person made since are kept; what they touched is listed in kept.",
  "type": "object",
  "properties": {
    "ok": { "const": true },
    "batch": { "description": "The new batch that undid them.", "$ref": "common.schema.json#/$defs/batch_id" },
    "reverted": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/batch_id" }, "minItems": 1, "maxItems": 100 },
    "kept": {
      "description": "Changes left in place because a person edited the same thing afterwards.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/element_id" },
          "why": { "type": "string", "maxLength": 400 }
        },
        "required": ["id", "why"],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "pending_sends": { "$ref": "common.schema.json#/$defs/pending_sends" }
  },
  "required": ["ok", "batch", "reverted", "pending_sends"],
  "additionalProperties": false
}
