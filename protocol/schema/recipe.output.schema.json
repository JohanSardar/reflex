{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reflex.eilmer.si/protocol/v0/recipe.output.schema.json",
  "title": "recipe result",
  "description": "The apply result fields, plus the ops the Recipe expanded to. They were applied as one batch; patch them like your own.",
  "type": "object",
  "properties": {
    "ok": { "const": true },
    "batch": { "$ref": "common.schema.json#/$defs/batch_id" },
    "ops": {
      "description": "The expanded ops, as apply ops, with every ID filled in.",
      "type": "array",
      "items": { "type": "object" },
      "minItems": 1,
      "maxItems": 500
    },
    "ids": { "$ref": "apply.output.schema.json#/properties/ids" },
    "repaired": { "$ref": "apply.output.schema.json#/properties/repaired" },
    "lints": { "$ref": "apply.output.schema.json#/properties/lints" },
    "look": { "$ref": "look.output.schema.json" },
    "pending_sends": { "$ref": "common.schema.json#/$defs/pending_sends" }
  },
  "required": ["ok", "batch", "ops", "pending_sends"],
  "additionalProperties": false
}
