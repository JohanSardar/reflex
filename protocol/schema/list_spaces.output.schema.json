{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reflex.eilmer.si/protocol/v1/list_spaces.output.schema.json",
  "title": "list_spaces result",
  "type": "object",
  "properties": {
    "spaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "space": { "$ref": "common.schema.json#/$defs/space_name" },
          "title": { "type": "string", "maxLength": 120 },
          "unread": { "description": "Something changed since the person last looked at it.", "type": "boolean" },
          "pending_sends": { "description": "Sends from this Space waiting for you.", "$ref": "common.schema.json#/$defs/count" },
          "agents": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/display_name" }, "maxItems": 64 },
          "people": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/display_name" }, "maxItems": 256 },
          "viewing": { "description": "Whether the person has this Space open right now.", "type": "boolean" }
        },
        "required": ["space", "unread", "pending_sends"],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "pending_sends": { "$ref": "common.schema.json#/$defs/pending_sends" }
  },
  "required": ["spaces", "pending_sends"],
  "additionalProperties": false
}
