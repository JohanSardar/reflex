{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reflex.eilmer.si/protocol/v1/read.output.schema.json",
  "title": "read result",
  "description": "Exactly one of outline, elements or strokes is set, matching the requested detail. With detail full, files carries the contents of the file Elements read.",
  "type": "object",
  "properties": {
    "space": { "$ref": "common.schema.json#/$defs/space_name" },
    "outline": { "type": "array", "items": { "$ref": "scene-item.schema.json" }, "maxItems": 2000 },
    "elements": { "type": "array", "items": { "$ref": "element.schema.json" }, "maxItems": 500 },
    "strokes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "description": "The Ink Element's ID.", "$ref": "common.schema.json#/$defs/element_id" },
          "mark": { "description": "The Mark this stroke belongs to, if any.", "$ref": "common.schema.json#/$defs/mark_id" },
          "points": {
            "description": "[x, y, t, pressure] per sample: x and y in your coordinates (fractional), t in milliseconds since the stroke began, pressure from 0 to 1.",
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                { "type": "number" },
                { "type": "number" },
                { "type": "integer", "minimum": 0, "maximum": 86400000 },
                { "type": "number", "minimum": 0, "maximum": 1 }
              ],
              "items": false,
              "minItems": 4
            },
            "minItems": 1,
            "maxItems": 100000
          }
        },
        "required": ["id", "points"],
        "additionalProperties": false
      },
      "maxItems": 2000
    },
    "files": {
      "description": "detail full: the contents of the file Elements among ids. A text file comes as text; any other file is named by its mime and size, and the CLI writes its bytes to file.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/element_id" },
          "name": { "type": "string", "maxLength": 255 },
          "mime": { "type": "string", "maxLength": 255 },
          "size": { "$ref": "common.schema.json#/$defs/count" },
          "text": { "description": "The file's text, cut at 100,000 characters (truncated says so).", "type": "string", "maxLength": 100000 },
          "truncated": { "type": "boolean" },
          "missing": { "description": "true when this Link doesn't have the file's bytes yet. Read again once the device has synced it.", "type": "boolean" },
          "file": { "description": "CLI only: where the file's bytes were written.", "type": "string", "maxLength": 4096 }
        },
        "required": ["id", "name", "mime", "size"],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "elsewhere": {
      "description": "outline only: what matched nothing in this read.",
      "type": "object",
      "properties": { "on_screen": { "$ref": "common.schema.json#/$defs/count" }, "off_screen": { "$ref": "common.schema.json#/$defs/count" } },
      "required": ["on_screen", "off_screen"],
      "additionalProperties": false
    },
    "pending_sends": { "$ref": "common.schema.json#/$defs/pending_sends" }
  },
  "required": ["space", "pending_sends"],
  "minProperties": 3,
  "additionalProperties": false
}
