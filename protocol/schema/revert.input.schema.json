{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reflex.eilmer.si/protocol/v1/revert.input.schema.json",
  "title": "revert input",
  "description": "Set batch or last, not both. Only your own batches can be reverted.",
  "type": "object",
  "properties": {
    "space": { "$ref": "common.schema.json#/$defs/space_name" },
    "batch": { "$ref": "common.schema.json#/$defs/batch_id" },
    "last": { "description": "Revert your last n batches in this Space.", "type": "integer", "minimum": 1, "maximum": 100 }
  },
  "required": ["space"],
  "minProperties": 2,
  "maxProperties": 2,
  "additionalProperties": false
}
