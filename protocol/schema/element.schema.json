    },
    {
      "title": "image",
      "description": "A picture. Photos and PDF pages the person adds become images they can write on.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/element_id"
        },
        "type": {
          "const": "image"
        },
        "owner": {
          "$ref": "common.schema.json#/$defs/principal"
        },
        "bounds": {
          "$ref": "common.schema.json#/$defs/bounds"
        },
        "src": {
          "$ref": "#/$defs/src"
        },
        "alt": {
          "$ref": "#/$defs/alt"
        },
        "page": {
          "$ref": "#/$defs/page"
        },
        "data": {
          "$ref": "#/$defs/data"
        },
        "values": {
          "$ref": "#/$defs/values"
        },
        "behaviors": {
          "$ref": "#/$defs/behaviors"
        },
        "draggable": {
          "$ref": "#/$defs/draggable"
        },
        "locked": {
          "$ref": "#/$defs/locked"
        },
        "snap": {
          "$ref": "#/$defs/snap"
        }
      },
      "required": [
        "id",
        "type",
        "owner",
        "bounds",
        "src"
      ],
      "additionalProperties": false
    },
    {
      "title": "frame",
      "description": "A titled container. Elements placed inside it move with it.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/element_id"
        },
        "type": {
          "const": "frame"
        },
        "owner": {
          "$ref": "common.schema.json#/$defs/principal"
        },
        "bounds": {
          "$ref": "common.schema.json#/$defs/bounds"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "data": {
          "$ref": "#/$defs/data"
        },
        "values": {
          "$ref": "#/$defs/values"
