{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reflex.eilmer.si/protocol/v0/element.schema.json",
  "title": "Element",
  "description": "One Element as read(detail: 'full') returns it and as the scene JSON every renderer draws from. Built-in types have typed, top-level fields; extension types put theirs in props. type is the discriminator. Coordinates are the reading Agent's.",
  "oneOf": [
    {
      "title": "text",
      "description": "Plain text or Markdown.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/element_id"
        },
        "type": {
          "const": "text"
        },
        "owner": {
          "$ref": "common.schema.json#/$defs/principal"
        },
        "bounds": {
          "$ref": "common.schema.json#/$defs/bounds"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "markdown": {
          "$ref": "#/$defs/markdown"
        },
        "size": {
          "$ref": "#/$defs/size"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "align": {
          "$ref": "#/$defs/align"
        },
        "data": {
          "$ref": "#/$defs/data"
        },
        "values": {
          "$ref": "#/$defs/values"
        },
        "behaviors": {
          "$ref": "#/$defs/behaviors"
        },
        "draggable": {
          "$ref": "#/$defs/draggable"
        },
        "locked": {
          "$ref": "#/$defs/locked"
        },
        "snap": {
          "$ref": "#/$defs/snap"
        }
      },
      "required": [
        "id",
        "type",
        "owner",
        "bounds",
        "text"
      ],
      "additionalProperties": false
    },
    {
      "title": "note",
