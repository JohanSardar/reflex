          "$ref": "#/$defs/data"
        },
        "values": {
          "$ref": "#/$defs/values"
        },
        "behaviors": {
          "$ref": "#/$defs/behaviors"
        },
        "draggable": {
          "$ref": "#/$defs/draggable"
        },
        "locked": {
          "$ref": "#/$defs/locked"
        },
        "snap": {
          "$ref": "#/$defs/snap"
        }
      },
      "required": [
        "id",
        "type",
        "owner",
        "bounds",
        "shape"
      ],
      "additionalProperties": false
    },
    {
      "title": "connector",
      "description": "A line or arrow. Bind both ends to Elements with from and to, and it follows them when they move. Or give points for a free line, such as an underline.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/element_id"
        },
        "type": {
          "const": "connector"
        },
        "owner": {
          "$ref": "common.schema.json#/$defs/principal"
        },
        "bounds": {
          "$ref": "common.schema.json#/$defs/bounds"
        },
