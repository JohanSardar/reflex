        }
      },
      "required": [
        "id",
        "type",
        "owner",
        "bounds",
        "name",
        "mime",
        "size",
        "src"
      ],
      "additionalProperties": false
    },
    {
      "title": "extension",
      "description": "An Element of an extension type (rung 3). Its fields live in props, checked against the type's own schema. An app that doesn't know the type keeps props untouched and draws it by its bounds.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/element_id"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,39}$",
          "not": {
            "enum": [
              "text",
              "note",
              "math",
              "shape",
              "connector",
              "image",
              "frame",
              "region",
              "embed",
              "ink",
              "file"
            ]
          }
        },
        "type_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "owner": {
          "$ref": "common.schema.json#/$defs/principal"
        },
        "bounds": {
          "$ref": "common.schema.json#/$defs/bounds"
        },
        "props": {
          "type": "object"
        },
        "data": {
          "$ref": "#/$defs/data"
        },
        "values": {
          "$ref": "#/$defs/values"
        },
        "behaviors": {
          "$ref": "#/$defs/behaviors"
        },
        "draggable": {
          "$ref": "#/$defs/draggable"
        },
        "locked": {
          "$ref": "#/$defs/locked"
        },
        "snap": {
          "$ref": "#/$defs/snap"
        }
      },
      "required": [
        "id",
        "type",
        "owner",
        "bounds",
        "props"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "agents_read_only": {
      "type": "boolean",
      "description": "When true, no Agent may write inside this Region. Default false."
    },
    "align": {
      "type": "string",
      "enum": [
        "start",
        "middle",
        "end"
      ]
    },
    "allow": {
      "description": "Extra network hosts this Embed may reach, on top of the person's allowlist.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9.-]{1,253}$"
      },
      "maxItems": 32
    },
    "alt": {
      "type": "string",
      "maxLength": 1000
    },
    "arrow": {
      "type": "string",
      "enum": [
        "end",
        "start",
        "both",
        "none"
      ]
    },
    "at": {
      "$ref": "common.schema.json#/$defs/placement"
    },
    "behaviors": {
      "description": "Trigger-action pairs, run when someone interacts with this Element.",
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/behavior"
      },
      "maxItems": 32
    },
    "color": {
      "$ref": "common.schema.json#/$defs/color"
    },
    "connector_text": {
      "type": "string",
      "maxLength": 400,
      "description": "A label drawn on the line."
    },
    "data": {
      "$ref": "common.schema.json#/$defs/data"
    },
    "draggable": {
      "type": "boolean",
      "description": "Whether the person can drag it. Default false for Agent Elements."
    },
    "file_size": {
      "$ref": "common.schema.json#/$defs/count",
      "description": "Size in bytes."
    },
    "file_src": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^asset:[0-9a-f]{64}$"
    },
    "fill": {
      "type": "string",
      "enum": [
        "none",
        "tint",
        "solid"
      ]
    },
    "from": {
      "$ref": "common.schema.json#/$defs/target_ref",
      "description": "The Element or Mark the line starts at."
    },
    "h": {
      "$ref": "common.schema.json#/$defs/length",
      "description": "Height. Reflex sizes it to fit its content when unset."
    },
    "html": {
      "type": "string",
      "maxLength": 200000
    },
    "ink": {
      "type": "boolean",
      "description": "Whether the person may draw Ink here. Default true."
    },
    "latex": {
      "type": "string",
      "maxLength": 20000,
      "description": "LaTeX source, without surrounding $ signs."
    },
    "locked": {
      "type": "boolean",
      "description": "When true, the person can't move, resize or delete it."
    },
    "markdown": {
      "type": "boolean"
    },
    "mime": {
      "type": "string",
      "maxLength": 255
    },
    "model": {
      "type": "string",
      "maxLength": 4096,
      "description": "A 3D model, USDZ or glTF (.glb, or .gltf with its files). Give an https URL or a file path on the Link's computer: Reflex reads it once, packs a glTF into one .glb, and stores it as 'asset:<sha256>', which is what you read back. In params, camera ({yaw, pitch, zoom}) sets the first view and parts ({<part>: {position, rotation, scale, highlight, hidden}}) moves, colors or hides parts. read_me('3d') explains it.",
      "pattern": "^(https://|asset:[0-9a-f]{64}$|file:///|/|~/)"
    },
    "name": {
      "type": "string",
      "maxLength": 255
    },
    "new_id": {
      "$ref": "common.schema.json#/$defs/element_id",
      "description": "Your ID for it. Reflex generates one when unset and reports it in the result's ids."
    },
    "note_text": {
      "type": "string",
      "maxLength": 4000
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000,
      "description": "For a PDF page: its 1-based page number."
    },
    "params": {
      "$ref": "common.schema.json#/$defs/params"
    },
    "parent": {
      "$ref": "common.schema.json#/$defs/element_id",
      "description": "When this is a fragment left by a precise erase: the stroke it came from."
    },
    "points": {
      "description": "A free polyline in your coordinates, used when from and to are not set.",
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/point"
      },
      "minItems": 2,
      "maxItems": 1000
    },
    "send_button": {
      "type": "string",
      "maxLength": 60,
      "description": "The label of a Send button scoped to this Region, such as 'Check my work'. Unset means no button."
    },
    "set_data": {
      "$ref": "common.schema.json#/$defs/data",
      "description": "Replace the whole data map. To change one key, use map_put."
    },
    "set_props": {
      "type": "object",
      "description": "Extension types only: replace these props."
    },
    "shape": {
      "type": "string",
      "enum": [
        "rect",
        "rounded",
        "ellipse",
        "diamond",
        "triangle",
        "hexagon"
      ]
    },
    "shape_text": {
      "type": "string",
      "maxLength": 4000
    },
    "size": {
      "$ref": "common.schema.json#/$defs/text_size"
    },
    "snap": {
      "$ref": "common.schema.json#/$defs/snap"
    },
    "src": {
      "type": "string",
      "maxLength": 4096,
      "description": "An https URL, or an asset reference 'asset:<sha256>'.",
      "pattern": "^(https://|asset:[0-9a-f]{64}$)"
    },
    "state": {
      "type": "object",
      "description": "State the Embed saved with reflex.element.setState: it syncs to every device, survives reloads and shows in the next Send's changes. Read only."
    },
    "stroke": {
      "type": "string",
      "enum": [
        "solid",
        "dashed",
        "dotted"
      ]
    },
    "template": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "text": {
      "type": "string",
      "maxLength": 20000,
      "description": "The text. With markdown: true it is rendered as Markdown."
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "to": {
      "$ref": "common.schema.json#/$defs/target_ref",
      "description": "The Element or Mark the line ends at."
    },
    "tool": {
      "type": "string",
      "enum": [
        "pen",
        "pencil",
        "marker",
        "highlighter"
      ]
    },
    "url": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(ui://|https://)"
    },
    "values": {
      "type": "object",
      "description": "What the person entered in this Element's Panels: Panel ID → component ID → value (an Embed inside a Panel saves its state as its component's value). It syncs to every device and shows in the next Send's changes. Read only."
    },
    "w": {
      "$ref": "common.schema.json#/$defs/length",
      "description": "Width. Reflex sizes it to fit its content when unset."
    },
    "watch": {
      "type": "boolean",
      "description": "When true, debounced snapshots of this Region reach its Agent as Send Bundles with kind 'watch'. Default false."
    },
    "width": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000
    },
    "parts": {
      "description": "A 3D Embed's parts, from its model's named nodes: each part's name, its position (in its parent's space, what params.parts.<name>.position sets), and the center and size of its box in model units. Read only; Reflex fills it in when you read the Element.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "position": {
            "$ref": "common.schema.json#/$defs/vec3"
          },
          "center": {
            "$ref": "common.schema.json#/$defs/vec3"
          },
          "size": {
            "$ref": "common.schema.json#/$defs/vec3"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "maxItems": 500
    }
  }
}
