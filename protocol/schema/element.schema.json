        }
      },
      "required": [
        "id",
        "type",
        "owner",
        "bounds"
      ],
      "additionalProperties": false
    },
    {
      "title": "embed",
      "description": "Web or 3D content Reflex does not natively understand, sandboxed. Use one of: template (an Embed Template, with params), html (inline HTML), url (an MCP App 'ui://' resource or an https page), or model (a USDZ or glTF asset).",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/element_id"
        },
        "type": {
          "const": "embed"
        },
        "owner": {
          "$ref": "common.schema.json#/$defs/principal"
        },
        "bounds": {
          "$ref": "common.schema.json#/$defs/bounds"
        },
        "template": {
          "$ref": "#/$defs/template"
        },
        "params": {
          "$ref": "#/$defs/params"
        },
        "html": {
          "$ref": "#/$defs/html"
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "parts": {
          "$ref": "#/$defs/parts"
        },
        "allow": {
          "$ref": "#/$defs/allow"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "data": {
          "$ref": "#/$defs/data"
        },
        "values": {
          "$ref": "#/$defs/values"
        },
        "behaviors": {
          "$ref": "#/$defs/behaviors"
        },
        "draggable": {
          "$ref": "#/$defs/draggable"
        },
        "locked": {
          "$ref": "#/$defs/locked"
        },
        "snap": {
          "$ref": "#/$defs/snap"
        }
      },
      "required": [
        "id",
        "type",
        "owner",
        "bounds"
      ],
      "additionalProperties": false
    },
    {
      "title": "ink",
      "description": "One finished stroke of a person's Ink. Agents can never change or remove it. Read its points with read(detail: 'strokes').",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/element_id"
        },
        "type": {
          "const": "ink"
        },
        "owner": {
          "$ref": "common.schema.json#/$defs/principal"
        },
        "bounds": {
          "$ref": "common.schema.json#/$defs/bounds"
        },
        "tool": {
          "$ref": "#/$defs/tool"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "width": {
          "$ref": "#/$defs/width"
        },
        "parent": {
          "$ref": "#/$defs/parent"
        },
        "data": {
          "$ref": "#/$defs/data"
        },
        "values": {
          "$ref": "#/$defs/values"
        },
        "behaviors": {
          "$ref": "#/$defs/behaviors"
        },
        "draggable": {
          "$ref": "#/$defs/draggable"
        },
        "locked": {
          "$ref": "#/$defs/locked"
        },
        "snap": {
          "$ref": "#/$defs/snap"
        }
      },
      "required": [
        "id",
        "type",
        "owner",
        "bounds",
        "tool"
      ],
      "additionalProperties": false
    },
    {
      "title": "file",
      "description": "A file the person added that is not a picture. Read its contents with read(ids: [id], detail: 'full').",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/element_id"
        },
        "type": {
          "const": "file"
        },
        "owner": {
          "$ref": "common.schema.json#/$defs/principal"
        },
        "bounds": {
          "$ref": "common.schema.json#/$defs/bounds"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "mime": {
          "$ref": "#/$defs/mime"
        },
        "size": {
          "$ref": "#/$defs/file_size"
        },
        "src": {
          "$ref": "#/$defs/file_src"
        },
        "data": {
          "$ref": "#/$defs/data"
        },
        "values": {
          "$ref": "#/$defs/values"
        },
        "behaviors": {
          "$ref": "#/$defs/behaviors"
        },
        "draggable": {
