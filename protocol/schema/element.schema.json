      ],
      "additionalProperties": false
    },
    {
      "title": "region",
      "description": "An area with its own rules: whether Ink is allowed, whether Agents may write there, watch mode, and a Send button scoped to it.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/element_id"
        },
        "type": {
          "const": "region"
        },
        "owner": {
          "$ref": "common.schema.json#/$defs/principal"
        },
        "bounds": {
          "$ref": "common.schema.json#/$defs/bounds"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "ink": {
          "$ref": "#/$defs/ink"
        },
        "agents_read_only": {
          "$ref": "#/$defs/agents_read_only"
        },
        "watch": {
          "$ref": "#/$defs/watch"
        },
        "send_button": {
          "$ref": "#/$defs/send_button"
        },
        "data": {
          "$ref": "#/$defs/data"
        },
        "values": {
          "$ref": "#/$defs/values"
        },
        "behaviors": {
          "$ref": "#/$defs/behaviors"
        },
        "draggable": {
