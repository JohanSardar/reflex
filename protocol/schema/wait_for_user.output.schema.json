{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reflex.eilmer.si/protocol/v1/wait_for_user.output.schema.json",
  "title": "wait_for_user result",
  "description": "A Send Bundle, or still_waiting when the timeout passed with nothing to deliver.",
  "oneOf": [
    { "$ref": "send-bundle.schema.json" },
    {
      "title": "still_waiting",
      "type": "object",
      "properties": {
        "status": { "const": "still_waiting" },
        "pending_sends": { "$ref": "common.schema.json#/$defs/pending_sends" },
        "next": { "type": "string", "maxLength": 400 }
      },
      "required": ["status", "pending_sends", "next"],
      "additionalProperties": false
    }
  ]
}
